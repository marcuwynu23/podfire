{
  "name": "podfire",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "agent-gateway": "node agent-gateway.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run agent-gateway\"",
    "build": "next build",
    "start": "node server.js",
    "lint": "eslint . --max-warnings 0",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma db studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "next": "^16.2.12",
    "octokit": "^3.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-syntax-highlighter": "^16.1.1",
    "ws": "^8.21.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.4.47",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
